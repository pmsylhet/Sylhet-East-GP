rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints
    function isValidUserSyncProfile(data) {
      return data.keys().hasAll(['uid', 'deviceCount', 'activeDeviceId', 'keyFingerprint', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'deviceCount', 'activeDeviceId', 'keyFingerprint', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.deviceCount is int && data.deviceCount >= 1 && data.deviceCount <= 50
        && data.activeDeviceId is string && data.activeDeviceId.size() >= 3 && data.activeDeviceId.size() <= 64 && data.activeDeviceId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.keyFingerprint is string && data.keyFingerprint.size() >= 16 && data.keyFingerprint.size() <= 128 && data.keyFingerprint.matches('^[a-fA-F0-9]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEncryptedSyncRecord(data) {
      return data.keys().hasAll([
          'ownerId', 'deviceId', 'deviceLabel', 'androidApiLevel',
          'recordType', 'ivBase64', 'saltBase64', 'ciphertextBase64',
          'checksumSha256', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'deviceId', 'deviceLabel', 'androidApiLevel',
          'recordType', 'ivBase64', 'saltBase64', 'ciphertextBase64',
          'checksumSha256', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.deviceId is string && data.deviceId.size() >= 3 && data.deviceId.size() <= 64 && data.deviceId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 64
        && data.androidApiLevel is int && data.androidApiLevel >= 26 && data.androidApiLevel <= 36
        && data.recordType is string && data.recordType in ['preferences', 'monthly_report', 'pinned_sites', 'telemetry_bundle']
        && data.ivBase64 is string && data.ivBase64.size() >= 8 && data.ivBase64.size() <= 48
        && data.saltBase64 is string && data.saltBase64.size() >= 16 && data.saltBase64.size() <= 64
        && data.ciphertextBase64 is string && data.ciphertextBase64.size() >= 8 && data.ciphertextBase64.size() <= 100000
        && data.checksumSha256 is string && data.checksumSha256.size() == 64 && data.checksumSha256.matches('^[a-f0-9]{64}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. User Sync Profiles Collection
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSyncProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSyncProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['deviceCount', 'activeDeviceId', 'keyFingerprint', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['activeDeviceId', 'updatedAt'])
        );

      allow delete: if false;

      // 5. Encrypted Snapshots Sub-Collection (Master Gate + Secure List)
      match /encryptedSnapshots/{snapshotId} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(snapshotId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(snapshotId)
          && isOwner(userId)
          && isValidEncryptedSyncRecord(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(snapshotId)
          && isOwner(userId)
          && isValidEncryptedSyncRecord(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'deviceId', 'deviceLabel', 'androidApiLevel', 'recordType',
              'ivBase64', 'saltBase64', 'ciphertextBase64', 'checksumSha256', 'updatedAt'
            ])
          );

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(snapshotId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
